        self.log.see("end")
        self.log.configure(state="disabled")

    def refresh_status(self) -> None:
        """Check whether each configured local port accepts TCP connections."""
        def worker() -> None:
            results = [
                (name, port, port_is_open(port)) for name, port in SERVICES
            ]

            def update_ui() -> None:
                for _name, port, is_open in results:
                    self.table.set(
                        str(port),
                        "status",
                        "LISTENING" if is_open else "NOT RUNNING",
                    )
                up = sum(1 for _name, _port, state in results if state)
                self.write_log(
                    f"Status check complete: {up}/{len(SERVICES)} ports listening."
                )

            self.after(0, update_ui)

        threading.Thread(target=worker, daemon=True).start()

    def refresh_http_health(self) -> None:
        """Probe HTTP endpoints without assuming Actuator is enabled."""
        def probe(name: str, port: int) -> tuple[int, str]:
            if name == "Eureka":
                candidates = ["/actuator/health", "/eureka/apps", "/"]
            else:
                candidates = ["/actuator/health", "/"]

            last_result = "No HTTP response"
            for host in ("127.0.0.1", "::1"):
                for path in candidates:
                    url_host = f"[{host}]" if ":" in host else host
                    request = urllib.request.Request(
                        f"http://{url_host}:{port}{path}",
                        headers={"User-Agent": "MarketGrid-Control-Center/1.0"},
                    )
                    try:
                        with urllib.request.urlopen(request, timeout=2) as response:
                            status = response.status
                        if status == 200 and path == "/actuator/health":
                            return port, "HEALTH ENDPOINT 200"
                        if status == 200:
                            last_result = "HTTP 200 (reachable; health not confirmed)"
                        else:
                            last_result = f"HTTP {status} (reachable)"
                        break
                    except urllib.error.HTTPError as exc:
                        last_result = (
                            f"HTTP {exc.code} (reachable; health not confirmed)"
                        )
                        if exc.code in (401, 403):
                            break
                    except (urllib.error.URLError, TimeoutError, OSError):
                        continue

                if last_result != "No HTTP response":
                    break

            return port, last_result

        def worker() -> None:
            results = [
                (name, *probe(name, port)) for name, port in SERVICES
            ]

            def update_ui() -> None:
                for _name, port, result in results:
                    self.table.set(str(port), "http", result)
                good = sum(
                    1
                    for _name, _port, result in results
                    if result == "HEALTH ENDPOINT 200"
                )
                reachable = sum(
                    1 for _name, _port, result in results
                    if result != "No HTTP response"
                )
                self.write_log(
                    f"HTTP checks complete: {reachable}/{len(SERVICES)} endpoints "
                    f"responded; {good} returned Actuator health HTTP 200. "
                    "HTTP reachability alone does not prove application or database health."
                )

            self.after(0, update_ui)

        self.write_log(
            "Starting HTTP checks (Actuator first; fallback paths indicate reachability only)."
        )
        threading.Thread(target=worker, daemon=True).start()

    def _selected_definition(self):
        choice = self.service_choice.get()
        for definition in (self.startup_definitions or self._default_definitions()):
            if choice == f"{definition[0]} ({definition[1]})":
                return definition
        messagebox.showerror("Select service", "Choose a service from the list.")
        return None

    def _default_definitions(self):
        return [
            ("Eureka", 8761, BACKEND / "eureka-server", True),
            ("Tenant Service", 8086, BACKEND / "tenant-service", True),
            ("User Service", 8081, BACKEND / "user-service", True),
            ("Vendor Service", 8082, BACKEND / "vendor-service", True),
            ("Product Service", 8083, BACKEND / "product-service", True),
            ("Order Service", 8084, BACKEND / "order-service", True),
            ("Payment Service", 8085, BACKEND / "payment-service", True),
            ("API Gateway", 8080, BACKEND / "api-gateway", True),
            ("React Frontend", 5173, FRONTEND, False),
        ]

    def _ensure_startup_config(self):
        if self.startup_env and self.startup_definitions:
            return True

        maven = find_maven()
        if not maven:
            messagebox.showerror(
                "Maven not found",
                "Maven 3.9.16 was not found in your .m2 wrapper folder.",
            )
            return False

        env = os.environ.copy()
        for key, label in [
            ("DB_PASSWORD", "Database password"),
            ("JWT_SECRET", "JWT signing secret"),
            ("APP_PROVISIONING_SECRET", "Provisioning secret"),
        ]:
            if not env.get(key):
                value = simpledialog.askstring(
                    "Startup configuration",
                    f"Enter {label} ({key}):",
                    show="*",
                    parent=self,
                )
                if value is None or not value.strip():
                    self.write_log("Operation cancelled; required configuration was not supplied.")
                    return False
                env[key] = value

        definitions = self._default_definitions()
        self.startup_env = env
        self.startup_definitions = definitions
        return True

    def start_selected(self):
        if self.busy:
            messagebox.showinfo("Busy", "Wait for the current operation to finish.")
            return
        if not self._ensure_startup_config():
            return

        definition = self._selected_definition()
        if not definition:
            return
        name, port, folder, is_backend = definition

        if port_is_open(port):
            self.write_log(f"{name}: already listening on port {port}; no action needed.")
            self.refresh_status()
            return

        maven = find_maven()
        if not maven:
            messagebox.showerror("Maven not found", "Maven 3.9.16 was not found.")
            return

        self.busy = True
        self.write_log(f"Starting selected service: {name}.")
        threading.Thread(
            target=self._start_worker,
            args=([definition], maven, self.startup_env),
            daemon=True,
        ).start()

    def stop_selected(self):
        if self.busy:
            messagebox.showinfo("Busy", "Wait for the current operation to finish.")
            return

        definition = self._selected_definition()
        if not definition:
            return
        name = definition[0]
        proc = self.managed_processes.get(name)

        if proc is None or proc.poll() is not None:
            messagebox.showinfo(
                "Not managed",
                f"{name} was not launched by this panel. "
                "For safety, independently started processes are not stopped.",
            )
            self.write_log(f"{name}: not stopped because no live managed process was found.")
            return

        if not messagebox.askyesno("Confirm stop", f"Stop {name}?"):
            return

        self.busy = True
        threading.Thread(
            target=self._stop_worker, args=([(name, proc)],), daemon=True
        ).start()

    def restart_selected(self):
        if self.busy:
            messagebox.showinfo("Busy", "Wait for the current operation to finish.")
            return
        if not self._ensure_startup_config():
            return

        definition = self._selected_definition()
        if not definition:
            return

        name, port, folder, is_backend = definition
        proc = self.managed_processes.get(name)

        if proc is None or proc.poll() is not None:
            self.write_log(f"{name}: not managed; starting it if its port is free.")
            self.start_selected()
            return

        if not messagebox.askyesno("Confirm restart", f"Restart {name}?"):
            return

        maven = find_maven()
        if not maven:
            messagebox.showerror("Maven not found", "Maven 3.9.16 was not found.")
            return

        self.busy = True
        threading.Thread(
            target=self._restart_worker,
            args=(definition, proc, maven, self.startup_env),
            daemon=True,
        ).start()

    def _restart_worker(self, definition, proc, maven, env):
        name, port, folder, is_backend = definition
        try:
            subprocess.run(
                ["taskkill", "/PID", str(proc.pid), "/T", "/F"],
                capture_output=True, text=True, timeout=15, check=False,
            )
            deadline = time.monotonic() + 20
            while time.monotonic() < deadline and port_is_open(port):
                time.sleep(0.5)

            if port_is_open(port):
                self.after(0, lambda: self.write_log(
                    f"{name}: port {port} remains busy; restart aborted."
                ))
                self.after(0, self.refresh_status)
                return

            self.managed_processes.pop(name, None)
            self.after(0, lambda: self.write_log(f"{name}: stopped; starting again."))
            self._start_worker([definition], maven, env)
            return
        except Exception as exc:
            self.after(0, lambda: self.write_log(
                f"{name}: restart failed ({type(exc).__name__})."
            ))
        finally:
            self.after(0, self._idle)

    def restart_all(self):
        if self.busy:
            messagebox.showinfo("Busy", "Wait for the current operation to finish.")
            return
        if not self._ensure_startup_config():
            return

        active = [
            (name, proc)
            for name, proc in self.managed_processes.items()
            if proc.poll() is None
        ]
        if not active:
            messagebox.showinfo(
                "Nothing to restart",
                "No running services launched by this panel. Use Start All to launch them.",
            )
            return

        if not messagebox.askyesno(
            "Confirm Restart All",
            f"Restart {len(active)} service process tree(s) managed by this panel? "
            "Independently started services will not be stopped.",
        ):
            return

        maven = find_maven()
        if not maven:
            messagebox.showerror("Maven not found", "Maven 3.9.16 was not found.")
            return

        self.busy = True
        threading.Thread(
            target=self._restart_all_worker,
            args=(active, maven, self.startup_env, self.startup_definitions),
            daemon=True,
        ).start()

    def _restart_all_worker(self, active, maven, env, definitions):
        try:
            ports = {name: port for name, port, _folder, _backend in definitions}
            for name, proc in reversed(active):
                if proc.poll() is None:
                    subprocess.run(
                        ["taskkill", "/PID", str(proc.pid), "/T", "/F"],
                        capture_output=True, text=True, timeout=15, check=False,
                    )
                    self.after(0, lambda name=name: self.write_log(
                        f"{name}: stop requested."
                    ))

            deadline = time.monotonic() + 30
            while time.monotonic() < deadline:
                if all(not port_is_open(ports[name]) for name, _proc in active):
                    break
                time.sleep(0.5)

            still_open = [
                name for name, _proc in active
                if port_is_open(ports[name])
            ]
            if still_open:
                self.after(0, lambda: self.write_log(
                    "Restart stopped: ports still busy for " + ", ".join(still_open)
                ))
                self.after(0, self.refresh_status)
                return

            for name, _proc in active:
                self.managed_processes.pop(name, None)

            self.after(0, lambda: self.write_log("Restarting managed services in startup order."))
            self._start_worker(definitions, maven, env)
            return
        except Exception as exc:
            self.after(0, lambda: self.write_log(
                f"Restart All failed ({type(exc).__name__})."
            ))
        finally:
            self.after(0, self._idle)
    def start_all(self) -> None:
        """Launch missing services, leaving already-running services untouched."""
        if self.busy:
            messagebox.showinfo("Busy", "Wait for the current operation to finish.")
            return

        maven = find_maven()
        if not maven:
            messagebox.showerror(
                "Maven not found",
                "Maven 3.9.16 was not found in your .m2 wrapper folder.",
            )
            return

        env = os.environ.copy()
        for key, label in [
            ("DB_PASSWORD", "Database password"),
            ("JWT_SECRET", "JWT signing secret"),
            ("APP_PROVISIONING_SECRET", "Provisioning secret"),
        ]:
            if not env.get(key):
                value = simpledialog.askstring(
                    "Startup configuration",
                    f"Enter {label} ({key}):",
                    show="*",
                    parent=self,
                )
                if value is None:
                    self.write_log("Start All cancelled; no services were launched.")
                    return
                if not value.strip():
                    messagebox.showerror(
                        "Missing configuration", f"{key} cannot be empty."
                    )
                    return
                env[key] = value

        definitions = [
            ("Eureka", 8761, BACKEND / "eureka-server", True),
            ("Tenant Service", 8086, BACKEND / "tenant-service", True),
            ("User Service", 8081, BACKEND / "user-service", True),
            ("Vendor Service", 8082, BACKEND / "vendor-service", True),
            ("Product Service", 8083, BACKEND / "product-service", True),
            ("Order Service", 8084, BACKEND / "order-service", True),
            ("Payment Service", 8085, BACKEND / "payment-service", True),
            ("API Gateway", 8080, BACKEND / "api-gateway", True),
            ("React Frontend", 5173, FRONTEND, False),
        ]

        for name, _port, folder, is_backend in definitions:
            if is_backend and not (folder / "pom.xml").is_file():
                messagebox.showerror("Missing service", f"Missing pom.xml: {folder}")
                return
            if not is_backend and not (folder / "package.json").is_file():
                messagebox.showerror(
                    "Missing frontend", f"Missing {folder / 'package.json'}"
                )
                return

        self.busy = True
        self.write_log(
            "Start All requested. Existing listening services will be skipped."
        )
        threading.Thread(
            target=self._start_worker, args=(definitions, maven, env), daemon=True
        ).start()

    def _start_worker(self, definitions, maven: Path, env: dict[str, str]) -> None:
        """Start services sequentially and collect each process's output."""
        try:
            for name, port, folder, is_backend in definitions:
                if port_is_open(port):
                    self.after(
                        0,
                        lambda name=name, port=port: self.write_log(
                            f"{name}: already listening on {port}; skipped."
                        ),
                    )
                    continue

                if is_backend:
                    # .cmd files need cmd.exe on Windows. shell=True lets Python
                    # construct the cmd.exe invocation without literal backslash quotes.
                    command = f'call "{maven}" -B -ntp spring-boot:run'
                else:
                    command = "npm run dev -- --host localhost"

                try:
                    proc = subprocess.Popen(
                        command,
                        cwd=str(folder),
                        env=env,
                        shell=True,
                        stdin=subprocess.DEVNULL,
                        stdout=subprocess.PIPE,
                        stderr=subprocess.STDOUT,
                        text=True,
                        errors="replace",
                        creationflags=getattr(
                            subprocess, "CREATE_NEW_PROCESS_GROUP", 0
                        ),
                    )
                except Exception as exc:
                    self.after(
                        0,
                        lambda name=name, exc=exc: self.write_log(
                            f"{name}: launch failed ({type(exc).__name__})."
                        ),
                    )
                    continue

                self.managed_processes[name] = proc
                threading.Thread(
                    target=self._read_output, args=(name, proc), daemon=True
                ).start()
                self.after(
                    0,
                    lambda name=name, port=port, pid=proc.pid: self.write_log(
                        f"{name}: launched PID {pid}; waiting for port {port}."
                    ),
                )

                deadline = time.monotonic() + (90 if is_backend else 35)
                while time.monotonic() < deadline:
                    if port_is_open(port):
                        self.after(
                            0,
                            lambda name=name, port=port: self.write_log(
                                f"{name}: listening on port {port}."
                            ),
                        )
                        break
                    if proc.poll() is not None:
                        self.after(
                            0,
                            lambda name=name: self.write_log(
                                f"{name}: launcher exited before port became available; "
                                "inspect logs."
                            ),
                        )
                        break
                    time.sleep(1)
                else:
                    self.after(
                        0,
                        lambda name=name, port=port: self.write_log(
                            f"{name}: startup timed out on port {port}; continuing."
                        ),
                    )

            self.after(0, self.refresh_status)
            self.after(0, lambda: self.write_log("Start All sequence finished."))
        except Exception as exc:
            self.after(
                0,
                lambda exc=exc: self.write_log(
                    f"Start sequence error: {type(exc).__name__}."
                ),
            )
        finally:
            self.after(0, self._idle)

    def _read_output(self, name: str, proc: subprocess.Popen) -> None:
        """Forward child output to the UI while redacting likely secrets."""
        if proc.stdout is not None:
            for line in proc.stdout:
                self.after(
                    0,
                    lambda line=line, name=name: self.write_log(
                        f"[{name}] {line.rstrip()}"
                    ),
                )

    def _idle(self) -> None:
        self.busy = False

    def stop_all(self) -> None:
        """Stop only process trees launched by this Control Center."""
        if self.busy:
            messagebox.showinfo("Busy", "Wait for the current operation to finish.")
            return

        active = [
            (name, proc)
            for name, proc in self.managed_processes.items()
            if proc.poll() is None
        ]
        if not active:
            messagebox.showinfo(
                "Nothing to stop",
                "No running services were launched by this Control Center. "
                "Services started elsewhere were left untouched.",
            )
            self.write_log(
                "Stop All: no managed processes to stop; independent services untouched."
            )
            return

        if not messagebox.askyesno(
            "Confirm Stop All",
            f"Stop {len(active)} process tree(s) launched by this Control Center? "
            "Independently started services will not be targeted.",
        ):
            return

        self.busy = True
        threading.Thread(
            target=self._stop_worker, args=(active,), daemon=True
        ).start()

    def _stop_worker(self, active) -> None:
        try:
            for name, proc in reversed(active):
                if proc.poll() is None:
                    try:
                        subprocess.run(
                            ["taskkill", "/PID", str(proc.pid), "/T", "/F"],
                            capture_output=True,
                            text=True,
                            timeout=15,
                            check=False,
                        )
                        self.after(
                            0,
                            lambda name=name, pid=proc.pid: self.write_log(
                                f"{name}: stop requested for managed process tree PID {pid}."
                            ),
                        )
                    except Exception as exc:
                        self.after(
                            0,
                            lambda name=name, exc=exc: self.write_log(
                                f"{name}: stop request failed ({type(exc).__name__})."
                            ),
                        )

            time.sleep(1)
            self.after(0, self.refresh_status)
            self.after(
                0,
                lambda: self.write_log(
                    "Stop All finished; independently started services were not targeted."
                ),
            )
        finally:
            self.after(0, self._idle)

    def run_commands(
        self, title: str, commands: list[tuple[str, list[str], Path]]
    ) -> None:
        """Run validation commands in background threads and log their output."""
        def worker() -> None:
            self.after(0, lambda: self.write_log(f"\n=== {title} started ==="))
            failed = False

            for label, command, cwd in commands:
                self.after(0, lambda label=label: self.write_log(f"\n--- {label} ---"))
                try:
                    process = subprocess.Popen(
                        command,
                        cwd=str(cwd),
                        stdout=subprocess.PIPE,
                        stderr=subprocess.STDOUT,
                        text=True,
                        errors="replace",
                        env=os.environ.copy(),
                        shell=False,
                    )
                    assert process.stdout is not None
                    for line in process.stdout:
                        self.after(
                            0,
                            lambda line=line: self.write_log(line.rstrip()),
                        )
                    code = process.wait()
                    if code != 0:
                        failed = True
                        self.after(
                            0,
                            lambda label=label, code=code: self.write_log(
                                f"{label} FAILED (exit {code})"
                            ),
                        )
                    else:
                        self.after(
                            0,
                            lambda label=label: self.write_log(
                                f"{label} PASSED"
                            ),
                        )
                except Exception as exc:
                    failed = True
                    self.after(
                        0,
                        lambda label=label, exc=exc: self.write_log(
                            f"{label}: could not run ({type(exc).__name__}). "
                            "Check paths and installed tools."
                        ),
                    )

            result = "finished with failures" if failed else "completed successfully"
            self.after(0, lambda: self.write_log(f"=== {title} {result} ==="))
            self.after(
                0,
                lambda: messagebox.showinfo(
                    title, f"{title} {result}. See Activity log for details."
                ),
            )

        threading.Thread(target=worker, daemon=True).start()

    def run_backend_tests(self) -> None:
        """Run Maven tests for each backend service that exists."""
        maven = find_maven()
        if not maven:
            messagebox.showerror(
                "Maven not found",
                "Could not find Maven 3.9.16 under your user .m2 wrapper folder. "
                "No command was run.",
            )
            return

        service_names = [
            "user-service",
            "tenant-service",
            "vendor-service",
            "product-service",
            "order-service",
            "payment-service",
        ]
        commands = []
        for service in service_names:
            folder = BACKEND / service
            if (folder / "pom.xml").is_file():
                commands.append(
                    (f"{service} tests", [str(maven), "-B", "-ntp", "test"], folder)
                )
            else:
                self.write_log(f"Skipped {service}: pom.xml not found.")

        if not commands:
            messagebox.showerror(
                "No services found",
                "No service pom.xml files were found under backend.",
            )
            return

        self.run_commands("Backend tests", commands)

    def build_frontend(self) -> None:
        """Run the frontend production build."""
        package_file = FRONTEND / "package.json"
        if not package_file.is_file():
            messagebox.showerror(
                "Frontend not found", f"Missing {package_file}"
            )
            return

        command_shell = os.environ.get("ComSpec", r"C:\Windows\System32\cmd.exe")
        self.run_commands(
            "Frontend build",
            [
                (
                    "npm run build",
                    [command_shell, "/d", "/s", "/c", "npm run build"],
                    FRONTEND,
                )
            ],
        )


if __name__ == "__main__":
    if not BACKEND.is_dir() or not FRONTEND.is_dir():
        raise SystemExit(
            "Run this tool from its repository location: tools/marketgrid-control-center.py"
        )
    ControlCenter().mainloop()
