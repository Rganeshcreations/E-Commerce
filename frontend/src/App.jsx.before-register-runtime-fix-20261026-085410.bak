const API = "http://localhost:8080";
function getStoredCart() {
  try {
    return JSON.parse(localStorage.getItem("marketgrid_cart") || "[]");
  } catch {
    return [];
  }
}

function saveCart(items) {
  localStorage.setItem("marketgrid_cart", JSON.stringify(items));
  window.dispatchEvent(new Event("marketgrid_cart_updated"));
}

function useCartCount() {
  const [count, setCount] = useState(() => getStoredCart().length);

  useEffect(() => {
    const update = () => setCount(getStoredCart().length);

    window.addEventListener("marketgrid_cart_updated", update);
    window.addEventListener("storage", update);

    return () => {
      window.removeEventListener("marketgrid_cart_updated", update);
      window.removeEventListener("storage", update);
    };
  }, []);

  return count;
}

function formatINR(amount) {
  return new Intl.NumberFormat("en-IN", {
    style: "currency",
    currency: "INR",
    maximumFractionDigits: 2
  }).format(Number(amount) || 0);
}
function formatDisplayName(email) {
  if (!email) return "Customer";

  return email
    .split("@")[0]
    .split(/[._-]/)
    .filter(Boolean)
    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");
}

