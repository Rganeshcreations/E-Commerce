          <div
            style={{
              marginTop:"28px",
              padding:"28px",
              borderRadius:"18px",
              background:"#eff6ff",
              border:"1px solid #dbeafe",
              display:"flex",
              justifyContent:"space-between",
              alignItems:"center",
              gap:"20px",
              flexWrap:"wrap"
            }}
          >

            <div>
              <div
                style={{
                  color:"#2563eb",
                  fontSize:"12px",
                  fontWeight:"800",
                  letterSpacing:"2px"
                }}
