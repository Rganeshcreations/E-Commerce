      image: "https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?auto=format&fit=crop&w=800&q=80"
    },
    {
      id: 7,
      name: "Digital Camera",
      vendor: "PhotoPro",
      price: 42000,
      stock: 8,
      status: "Available",
      image: "https://images.unsplash.com/photo-1516035069371-29a1b244cc32?auto=format&fit=crop&w=800&q=80"
    },
    {
      id: 8,
      name: "Bluetooth Speaker",
      vendor: "SoundMax",
      price: 3200,
      stock: 22,
      status: "Available",
      image: "https://images.unsplash.com/photo-1608043152269-423dbba4e7e1?auto=format&fit=crop&w=800&q=80"
    },
    {
      id: 9,
      name: "Tablet",
      vendor: "Smart World",
      price: 18000,
      stock: 14,
      status: "Available",
      image: "https://images.unsplash.com/photo-1544244015-0df4b3ffc6b0?auto=format&fit=crop&w=800&q=80"
    }
  ]);

  const [addedId, setAddedId] = useState(null);

  function addToCart(product) {
    if (product.stock <= 0) return;

    const cart = getStoredCart();
    const existing = cart.find(item => item.id === product.id);

    if (existing) {
      existing.quantity = (existing.quantity || 1) + 1;
    } else {
      cart.push({
        ...product,
        quantity: 1,
        vendorId: product.vendorId || product.id
      });
    }

    saveCart(cart);

    setProducts(prev =>
      prev.map(item =>
        item.id === product.id
          ? {
              ...item,
              stock: item.stock - 1,
              status: item.stock - 1 === 0 ? "Out of Stock" : "Available"
            }
          : item
      )
    );

    setAddedId(product.id);

    setTimeout(() => {
      setAddedId(current => current === product.id ? null : current);
    }, 700);
  }

  return (
    <div className="content">

      <PageHead
        eyebrow="CUSTOMER MARKETPLACE"
        title="Discover products"
        description="Compare products from independent vendors in one secure marketplace."
        action={
          <Link className="primary-btn" to="/cart">
            <ShoppingCart size={17}/> Cart ({cartCount})
          </Link>
        }
      />

      <div className="filterbar">

        <div className="search-control">
          <Search size={17}/>
          <input placeholder="Search products..." />
        </div>

        <button className="filter">All Categories</button>
        <button className="filter">Sort: Popular</button>

      </div>

      <div className="product-grid">

        {products.map(p => (

          <div className="product-card" key={p.id}>

            <div
              className="product-image"
              style={{
                padding: "0",
                overflow: "hidden",
                background: "#f1f5f9"
              }}
            >
              <img
                src={p.image}
                alt={p.name}
                style={{
                  width: "100%",
                  height: "100%",
                  objectFit: "cover",
                  display: "block"
                }}
              />
            </div>

            <span className={`badge ${p.stock > 0 ? "green" : "red"}`}>
              {p.stock > 0 ? "Available" : "Out of Stock"}
            </span>

            <h3>{p.name}</h3>

            <p>{p.vendor}</p>

            <strong className="price">
              &#8377;{p.price.toLocaleString("en-IN")}
            </strong>

            <div style={{ marginTop: "8px" }}>

              <small>
                {p.stock > 0
                  ? `${p.stock} units available`
                  : "Currently unavailable"}
              </small>

              <div
                style={{
                  height: "6px",
                  background: "#e5e7eb",
                  borderRadius: "10px",
                  marginTop: "6px",
                  overflow: "hidden"
                }}
              >
                <div
                  style={{
                    width: `${Math.min(p.stock * 2.5, 100)}%`,
                    height: "100%",
                    background: p.stock > 0 ? "#2563eb" : "#94a3b8",
                    borderRadius: "10px",
                    transition: "width .3s ease"
                  }}
                />
              </div>

            </div>

            <div className="card-row">

              <button
                className="secondary-btn small"
                onClick={() => navigate(`/products/${p.id}`)}
              >
                <Eye size={15}/> View
              </button>

              <button
                className="primary-btn small"
                disabled={p.stock <= 0}
                onClick={() => addToCart(p)}
                style={{
                  transform: addedId === p.id ? "scale(.94)" : "scale(1)",
                  opacity: p.stock <= 0 ? 0.55 : 1,
                  transition: "transform .12s ease, opacity .2s ease",
                  background: addedId === p.id ? "#16a34a" : undefined
                }}
              >
                <ShoppingCart size={15}/>
                {addedId === p.id ? "Added ÃƒÂ¢Ã…â€œÃ¢â‚¬Å“" : p.stock <= 0 ? "Sold Out" : "Add"}
              </button>

            </div>

          </div>

        ))}

      </div>

    </div>
  );
}
function Cart() {
  const navigate = useNavigate();
  const [cart, setCart] = useState(() => getStoredCart());

  useEffect(() => {
    const update = () => setCart(getStoredCart());

    window.addEventListener("marketgrid_cart_updated", update);
    window.addEventListener("storage", update);

    return () => {
      window.removeEventListener("marketgrid_cart_updated", update);
      window.removeEventListener("storage", update);
    };
  }, []);

  function removeItem(id) {
    const updated = cart.filter(item => item.id !== id);
    saveCart(updated);
    setCart(updated);
  }

  function changeQuantity(id, amount) {
    const updated = cart.map(item => {
      if (item.id !== id) return item;

      return {
        ...item,
        quantity: Math.max(1, (item.quantity || 1) + amount)
      };
    });

    saveCart(updated);
    setCart(updated);
  }

  function clearCart() {
    saveCart([]);
    setCart([]);
  }

  const total = cart.reduce(
    (sum, item) => sum + item.price * (item.quantity || 1),
    0
  );

  if (cart.length === 0) {
    return (
      <div className="content narrow">

        <PageHead
          eyebrow="SHOPPING CART"
          title="Your cart"
          description="Review your selected products before checkout."
        />

        <div className="empty-card">

          <ShoppingCart size={48}/>

          <h2>Your cart is empty</h2>

          <p>
            Add products from the marketplace to begin your order.
          </p>

          <Link
            className="primary-btn"
            to="/shop/products"
          >
            Continue Shopping
          </Link>

        </div>

      </div>
    );
  }

  return (
    <div className="content narrow">

      <PageHead
        eyebrow="SHOPPING CART"
        title="Your cart"
        description={`${cart.length} product(s) selected.`}
      />

      <div className="table-card">

        <div className="table-head">

          <div>
            <b>Selected Products</b>
            <small>Review your products before checkout.</small>
          </div>

          <button
            className="secondary-btn small"
            onClick={clearCart}
          >
            <Trash2 size={15}/>
            Clear Cart
          </button>

        </div>

        <table>

          <thead>
            <tr>
              <th>PRODUCT</th>
              <th>VENDOR</th>
              <th>PRICE</th>
              <th>QUANTITY</th>
              <th>TOTAL</th>
              <th></th>
            </tr>
          </thead>

          <tbody>

            {cart.map(item => {

              const quantity = item.quantity || 1;
              const itemTotal = item.price * quantity;

              return (
                <tr key={item.id}>

                  <td>
                    <b>{item.name}</b>
                  </td>

                  <td>{item.vendor}</td>

                  <td>
                    {formatINR(item.price)}
                  </td>

                  <td>

                    <div
                      style={{
                        display: "flex",
                        alignItems: "center",
                        gap: "8px"
                      }}
                    >

                      <button
                        className="icon-btn"
                        onClick={() =>
                          changeQuantity(item.id, -1)
                        }
                      >
                        -
                      </button>

                      <b>{quantity}</b>

                      <button
                        className="icon-btn"
                        onClick={() =>
                          changeQuantity(item.id, 1)
                        }
                      >
                        +
                      </button>

                    </div>

                  </td>

                  <td>
                    <b>
                      {formatINR(itemTotal)}
                    </b>
                  </td>

                  <td>

                    <button
                      className="icon-btn"
                      onClick={() => removeItem(item.id)}
                      title="Remove product"
                    >
                      <Trash2 size={16}/>
                    </button>

                  </td>

                </tr>
              );

            })}

          </tbody>

        </table>

      </div>

      <div
        className="panel"
        style={{
          marginTop: "20px",
          padding: "24px"
        }}
      >

        <div
          style={{
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
            gap: "20px",
            flexWrap: "wrap"
          }}
        >

          <div>

            <small>Cart Total</small>

            <h2 style={{ margin: "5px 0" }}>
              {formatINR(total)}
            </h2>

          </div>

          <div className="action-row">

            <button
              className="secondary-btn"
              onClick={() => navigate("/shop/products")}
            >
              Continue Shopping
            </button>

            <button
              className="primary-btn"
              onClick={() => navigate("/checkout")}
            >
              Proceed to Checkout
              <ChevronRight size={17}/>
            </button>

          </div>

        </div>

      </div>

    </div>
  );
}

function Checkout() {
  const navigate = useNavigate();
  const [cart, setCart] = useState(() => getStoredCart());
  const [paymentMethod, setPaymentMethod] = useState("UPI");
  const [processing, setProcessing] = useState(false);
  const [success, setSuccess] = useState(false);
  const [transactionId, setTransactionId] = useState("");

  const [form, setForm] = useState({
    fullName: "",
    phone: "",
    address: "",
    city: "",
    pincode: ""
  });

  const subtotal = cart.reduce(
    (sum, item) => sum + item.price * (item.quantity || 1),
    0
  );

  const delivery = 0;
  const total = subtotal + delivery;

  function updateForm(e) {
    const { name, value } = e.target;
    setForm(prev => ({ ...prev, [name]: value }));
  }

  function placeOrder() {
    if (
      !form.fullName ||
      !form.phone ||
      !form.address ||
      !form.city ||
      !form.pincode
    ) {
      alert("Please complete all delivery information.");
      return;
    }

    if (cart.length === 0) {
      alert("Your cart is empty.");
      navigate("/shop/products");
      return;
    }

    setProcessing(true);

    setTimeout(() => {
      const txn = "TXN-DEMO-" + Date.now();

      setTransactionId(txn);
      setProcessing(false);
      setSuccess(true);

      localStorage.setItem(
        "marketgrid_last_order",
        JSON.stringify({
          items: cart,
          total,
          paymentMethod,
          transactionId: txn,
          delivery: form,
          createdAt: new Date().toISOString()
        })
      );

      saveCart([]);
    }, 1200);
  }

  if (success) {
    return (
      <div className="checkout-page">
        <div className="checkout-success">

          <div className="success-icon">
            
          </div>

          <span className="checkout-eyebrow">
            ORDER CONFIRMED
          </span>

          <h1>Payment Successful</h1>

          <p>
            Your order has been placed successfully.
            We have recorded your payment and delivery information.
          </p>

          <div className="success-details">
            <div>
              <span>Transaction ID</span>
              <strong>{transactionId}</strong>
            </div>

            <div>
              <span>Payment Method</span>
              <strong>{paymentMethod}</strong>
            </div>

            <div>
              <span>Amount Paid</span>
              <strong>
                {formatINR(total)}
              </strong>
            </div>
          </div>

          <div className="success-actions">
            <button
              className="primary-btn"
              onClick={() => navigate("/orders")}
            >
              View My Orders
            </button>

            <button
              className="secondary-btn"
              onClick={() => navigate("/shop/products")}
            >
              Continue Shopping
            </button>
          </div>

        </div>
      </div>
    );
  }

  return (
    <div className="checkout-page">

      <div className="checkout-header">

        <div>
          <span className="checkout-eyebrow">
            SECURE CHECKOUT
          </span>

          <h1>Complete your order</h1>

          <p>
            Enter your delivery details and choose your preferred payment method.
          </p>
        </div>

        <div className="checkout-security">
          <ShieldCheck size={19}/>
          <span>Secure checkout</span>
        </div>

      </div>

      <div className="checkout-steps">

        <div className="checkout-step active">
          <span>1</span>
          <div>
            <strong>Delivery</strong>
            <small>Address details</small>
          </div>
        </div>

        <div className="step-line"></div>

        <div className="checkout-step active">
          <span>2</span>
          <div>
            <strong>Payment</strong>
            <small>Choose method</small>
          </div>
        </div>

        <div className="step-line"></div>

        <div className="checkout-step">
          <span>3</span>
          <div>
            <strong>Confirmation</strong>
            <small>Order placed</small>
          </div>
        </div>

      </div>

      <div className="checkout-grid">

        <div className="checkout-main">

          <section className="checkout-card">

            <div className="checkout-card-title">
              <div className="checkout-title-icon">
                <Truck size={20}/>
              </div>

              <div>
                <h2>Delivery Information</h2>
                <p>Where should we deliver your order?</p>
              </div>
            </div>

            <div className="checkout-form">

              <div className="checkout-field full">
                <label>Full Name</label>
                <input
                  name="fullName"
                  value={form.fullName}
                  onChange={updateForm}
                  placeholder="Enter your full name"
                />
              </div>

              <div className="checkout-field">
                <label>Phone Number</label>
                <input
                  name="phone"
                  value={form.phone}
                  onChange={updateForm}
                  placeholder="10-digit mobile number"
                  maxLength="10"
                />
              </div>

              <div className="checkout-field">
                <label>City</label>
                <input
                  name="city"
                  value={form.city}
                  onChange={updateForm}
                  placeholder="Enter city"
                />
              </div>

              <div className="checkout-field full">
                <label>Delivery Address</label>
                <textarea
                  name="address"
                  value={form.address}
                  onChange={updateForm}
                  placeholder="House number, street, area"
                  rows="4"
                />
              </div>

              <div className="checkout-field">
                <label>Pincode</label>
                <input
                  name="pincode"
                  value={form.pincode}
                  onChange={updateForm}
                  placeholder="6-digit pincode"
                  maxLength="6"
                />
              </div>

            </div>

          </section>

          <section className="checkout-card">

            <div className="checkout-card-title">
              <div className="checkout-title-icon">
                <CreditCard size={20}/>
              </div>

              <div>
                <h2>Payment Method</h2>
                <p>Select how you would like to pay.</p>
              </div>
            </div>

            <div className="payment-options">

              <button
                type="button"
                className={`payment-option ${paymentMethod === "UPI" ? "selected" : ""}`}
                onClick={() => setPaymentMethod("UPI")}
              >
                <div className="payment-icon">UPI</div>
                <div>
                  <strong>UPI</strong>
                  <span>Google Pay, PhonePe, Paytm</span>
                </div>
                <div className="payment-radio">
                  {paymentMethod === "UPI" ? "" : ""}
                </div>
              </button>

              <button
                type="button"
                className={`payment-option ${paymentMethod === "CARD" ? "selected" : ""}`}
                onClick={() => setPaymentMethod("CARD")}
              >
                <div className="payment-icon">
                  <CreditCard size={20}/>
                </div>
                <div>
                  <strong>Card</strong>
                  <span>Credit / Debit Card</span>
                </div>
                <div className="payment-radio">
                  {paymentMethod === "CARD" ? "" : ""}
                </div>
              </button>

              <button
                type="button"
                className={`payment-option ${paymentMethod === "COD" ? "selected" : ""}`}
                onClick={() => setPaymentMethod("COD")}
              >
                <div className="payment-icon">
                  <Truck size={20}/>
                </div>
                <div>
                  <strong>Cash on Delivery</strong>
                  <span>Pay when your order arrives</span>
                </div>
                <div className="payment-radio">
                  {paymentMethod === "COD" ? "" : ""}
                </div>
              </button>

            </div>

            {paymentMethod === "UPI" && (
              <div className="demo-payment-box">
                <strong>UPI Payment</strong>
                <span>Demo payment mode  no real money is charged.</span>
                <input placeholder="Enter UPI ID (example@upi)" />
              </div>
            )}

            {paymentMethod === "CARD" && (
              <div className="demo-payment-box">
                <strong>Card Payment</strong>
                <span>Demo payment mode  no real money is charged.</span>
                <input placeholder="Card number" />
              </div>
            )}

            {paymentMethod === "COD" && (
              <div className="demo-payment-box">
                <strong>Cash on Delivery</strong>
                <span>
                  Pay the delivery partner when your order arrives.
                </span>
              </div>
            )}

          </section>

        </div>

        <aside className="checkout-summary">

          <div className="summary-header">
            <div className="checkout-title-icon">
              <ShoppingCart size={20}/>
            </div>

            <div>
              <h2>Order Summary</h2>
              <p>{cart.length} product{cart.length !== 1 ? "s" : ""}</p>
            </div>
          </div>

          <div className="summary-items">

            {cart.map(item => (
              <div className="summary-item" key={item.id}>

                <div className="summary-product-image">
                  {item.id === 1 ? "" : item.id === 2 ? "" : ""}
                </div>

                <div className="summary-product-info">
                  <strong>{item.name}</strong>
                  <span>{item.vendor}</span>
                  <small>Qty: {item.quantity || 1}</small>
                </div>

                <strong className="summary-price">
                  {formatINR(item.price * (item.quantity || 1))}
                </strong>

              </div>
            ))}

          </div>

          <div className="summary-divider"></div>

          <div className="summary-row">
            <span>Subtotal</span>
            <strong>{subtotal.toLocaleString("en-IN")}</strong>
          </div>

          <div className="summary-row">
            <span>Delivery</span>
            <strong className="free-text">FREE</strong>
          </div>

          <div className="summary-divider"></div>

          <div className="summary-total">
            <span>Total</span>
            <strong>{formatINR(total)}</strong>
          </div>

          <button
            className="checkout-place-btn"
            onClick={placeOrder}
            disabled={processing || cart.length === 0}
          >
            {processing ? "Processing Payment..." : `Place Order  ${formatINR(total)}`}
          </button>

          <div className="checkout-safe">
            <ShieldCheck size={17}/>
            <span>Your information is protected with secure authentication.</span>
          </div>

        </aside>

      </div>

    </div>
  );
}

function Vendors() {
  return (
    <div className="content">
      <PageHead eyebrow="MARKETPLACE SELLERS" title="Trusted vendors" description="Explore independent sellers operating on MarketGrid."/>
      <div className="vendor-grid">
        {demoVendors.map(v=>(
          <div className="vendor-card" key={v.id}>
            <div className="vendor-avatar">{v.name[0]}</div>
            <div><h3>{v.name}</h3><p>{v.email}</p></div>
            <span className="badge green">{v.status}</span>
            <div className="vendor-meta"><span>{v.products} products</span><button className="secondary-btn small">View Store</button></div>
          </div>
        ))}
      </div>
    </div>
  );
}

function Orders() {
  const [orders, setOrders] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  const token = localStorage.getItem("marketgrid_token");
  const role = localStorage.getItem("marketgrid_role");
  const customerId = Number(
    localStorage.getItem("marketgrid_customer_id") ||
    localStorage.getItem("marketgrid_user_id")
  );

  async function loadOrders() {
    setLoading(true);
    setError("");

    try {
      const response = await fetch(API + "/api/orders", {
        headers: {
          Authorization: "Bearer " + token
        }
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.message || "Failed to load orders");
      }

      const customerOrders =
        role === "CUSTOMER"
          ? data.filter(order => Number(order.customerId) === customerId)
          : data;

      setOrders(
        customerOrders.sort(
          (a, b) => Number(b.id) - Number(a.id)
        )
      );
    } catch (e) {
      setError(e.message);
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    loadOrders();
  }, []);

  if (loading) {
    return (
      <div className="content">

        <PageHead
          eyebrow="ORDER MANAGEMENT"
          title="My Orders"
          description="Track your purchases across marketplace vendors."
        />

        <div
          style={{
            background: "#fff",
            border: "1px solid #e2e8f0",
            borderRadius: "20px",
            padding: "70px 30px",
            textAlign: "center"
          }}
        >
          <Package
            size={48}
            style={{ color: "#2563eb", marginBottom: "15px" }}
          />

          <h2 style={{ margin: 0 }}>
            Loading your orders...
          </h2>

          <p style={{ color: "#64748b" }}>
            Please wait while we fetch your latest purchases.
          </p>
        </div>

      </div>
    );
  }

  return (
    <div className="content">

      <PageHead
        eyebrow="ORDER MANAGEMENT"
        title="My Orders"
        description="Track your purchases across marketplace vendors."
        action={
          <button
            className="secondary-btn"
            onClick={loadOrders}
          >
            Refresh
          </button>
        }
      />

      {error && (
        <div className="error-box">
          {error}
        </div>
      )}

      {!error && orders.length === 0 && (
        <div className="empty-card">

          <Package size={52}/>

          <h2>No orders yet</h2>

          <p>
            Your purchases will appear here after you place an order.
          </p>

          <Link
            to="/shop"
            className="primary-btn"
          >
            Continue Shopping
          </Link>

        </div>
      )}

      <div
        style={{
          display: "flex",
          flexDirection: "column",
          gap: "18px"
        }}
      >

        {orders.map(order => {

          const status = String(
            order.status || "PLACED"
          ).toUpperCase();

          const statusClass =
            status === "DELIVERED"
              ? "green"
              : status === "CANCELLED"
              ? "red"
              : status === "SHIPPED"
              ? "blue"
              : "blue";

          const createdDate = order.createdAt
            ? new Date(order.createdAt).toLocaleDateString(
                "en-IN",
                {
                  day: "2-digit",
                  month: "short",
                  year: "numeric"
                }
              )
            : "Recent order";

          return (
            <div
              key={order.id}
              style={{
                background: "#ffffff",
                border: "1px solid #e2e8f0",
                borderRadius: "20px",
                overflow: "hidden",
                boxShadow: "0 8px 25px rgba(15,23,42,.05)"
              }}
            >

              {/* ORDER HEADER */}

              <div
                style={{
                  padding: "18px 22px",
                  background: "#f8fafc",
                  borderBottom: "1px solid #e2e8f0",
                  display: "flex",
                  justifyContent: "space-between",
                  alignItems: "center",
                  gap: "15px",
                  flexWrap: "wrap"
                }}
              >

                <div>
                  <div
                    style={{
                      display: "flex",
                      alignItems: "center",
                      gap: "12px",
                      flexWrap: "wrap"
                    }}
                  >

                    <strong
                      style={{
                        fontSize: "20px",
                        color: "#0f172a"
                      }}
                    >
                      Order #{order.id}
                    </strong>

                    <span
                      className={"badge " + statusClass}
                    >
                      {status}
                    </span>

                  </div>

                  <div
                    style={{
                      marginTop: "6px",
                      color: "#64748b",
                      fontSize: "14px"
                    }}
                  >
                    Placed on {createdDate}
                  </div>

                </div>

                <div
                  style={{
                    textAlign: "right"
                  }}
                >

                  <div
                    style={{
                      fontSize: "13px",
                      color: "#64748b"
                    }}
                  >
                    Order Total
                  </div>

                  <strong
                    style={{
                      fontSize: "21px",
                      color: "#0f172a"
                    }}
                  >
                    &#8377;{Number(
                      order.totalAmount || 0
                    ).toLocaleString("en-IN")}
                  </strong>

                </div>

              </div>


              {/* ORDER ITEMS */}

              <div
                style={{
                  padding: "20px 22px"
                }}
              >

                <div
                  style={{
                    fontSize: "13px",
                    fontWeight: "700",
                    color: "#64748b",
                    textTransform: "uppercase",
                    letterSpacing: ".08em",
                    marginBottom: "12px"
                  }}
                >
                  Items in this order
                </div>

                <div
                  style={{
                    display: "flex",
                    flexDirection: "column",
                    gap: "10px"
                  }}
                >

                  {(order.items || []).map(
                    (item, index) => (

                    <div
                      key={index}
                      style={{
                        display: "flex",
                        alignItems: "center",
                        justifyContent: "space-between",
                        gap: "15px",
                        padding: "14px",
                        background: "#f8fafc",
                        borderRadius: "12px",
                        border: "1px solid #eef2f7",
                        flexWrap: "wrap"
                      }}
                    >

                      <div
                        style={{
                          display: "flex",
                          alignItems: "center",
                          gap: "13px"
                        }}
                      >

                        <div
                          style={{
                            width: "44px",
                            height: "44px",
                            borderRadius: "10px",
                            background: "#eaf2ff",
                            display: "flex",
                            alignItems: "center",
                            justifyContent: "center",
                            color: "#2563eb",
                            flexShrink: 0
                          }}
                        >
                          <Package size={21}/>
                        </div>

                        <div>

                          <strong
                            style={{
                              display: "block",
                              color: "#0f172a"
                            }}
                          >
                            Product #{item.productId}
                          </strong>

                          <span
                            style={{
                              color: "#64748b",
                              fontSize: "14px"
                            }}
                          >
                            Vendor #{item.vendorId}
                          </span>

                        </div>

                      </div>

                      <div
                        style={{
                          display: "flex",
                          alignItems: "center",
                          gap: "24px"
                        }}
                      >

                        <span
                          style={{
                            color: "#475569",
                            fontSize: "14px"
                          }}
                        >
                          Qty: <strong>{item.quantity}</strong>
                        </span>

                        <strong
                          style={{
                            color: "#0f172a"
                          }}
                        >
                          &#8377;{Number(
                            item.price || 0
                          ).toLocaleString("en-IN")}
                        </strong>

                      </div>

                    </div>

                  ))}

                </div>

              </div>


              {/* ORDER FOOTER */}

              <div
                style={{
                  padding: "16px 22px",
                  borderTop: "1px solid #e2e8f0",
                  display: "flex",
                  justifyContent: "space-between",
                  alignItems: "center",
                  gap: "15px",
                  flexWrap: "wrap"
                }}
              >

                <div
                  style={{
                    color: "#64748b",
                    fontSize: "14px"
                  }}
                >
                  Tenant #{order.tenantId}
                  <span style={{ margin: "0 8px" }}>
                    ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¢
                  </span>
                  {order.items?.length || 0} item
                  {(order.items?.length || 0) !== 1
                    ? "s"
                    : ""}
                </div>

                <Link
                  to={"/orders/" + order.id}
                  className="primary-btn"
                >
                  View Details
                </Link>

              </div>

            </div>
          );
        })}

      </div>

    </div>
  );
}
function OrderDetails() {
  const { id } = useParams();
  const [order, setOrder] = useState(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  const token = localStorage.getItem("marketgrid_token");
  const role = localStorage.getItem("marketgrid_role");
  const customerId = Number(localStorage.getItem("marketgrid_customer_id") || localStorage.getItem("marketgrid_user_id"));

  useEffect(() => {
    async function loadOrder() {
      try {
        const response = await fetch(API + "/api/orders/" + id, {
          headers: {
            Authorization: "Bearer " + token
          }
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.message || "Order not found");
        }

        if (
          role === "CUSTOMER" &&
          Number(data.customerId) !== customerId
        ) {
          throw new Error("You are not authorized to view this order.");
        }

        setOrder(data);
      } catch (e) {
        setError(e.message);
      } finally {
        setLoading(false);
      }
    }

    loadOrder();
  }, [id]);

  if (loading) {
    return (
      <div className="content narrow">
        <PageHead
          eyebrow="ORDER DETAILS"
          title="Loading order..."
          description="Fetching your order information."
        />
      </div>
    );
  }

  if (error || !order) {
    return (
      <div className="content narrow">
        <PageHead
          eyebrow="ORDER DETAILS"
          title="Order unavailable"
          description={error || "Order not found."}
        />

        <div className="empty-card">
          <Package size={48}/>
          <h2>Unable to open this order</h2>
          <p>{error || "The requested order could not be found."}</p>

          <Link to="/orders" className="primary-btn">
            Back to My Orders
          </Link>
        </div>
      </div>
    );
  }

  const status = String(order.status || "PLACED").toUpperCase();

  const steps = ["PLACED", "CONFIRMED", "SHIPPED", "DELIVERED"];

  let currentStep = steps.indexOf(status);

  if (currentStep < 0) {
    currentStep = status === "CANCELLED" ? 0 : 0;
  }

  return (
    <div className="content narrow">
      <PageHead
        eyebrow="ORDER DETAILS"
        title={"Order #" + order.id}
        description="View your order items, vendors, total and fulfillment status."
        action={
          <Link to="/orders" className="secondary-btn">
            Back to Orders
          </Link>
        }
      />

      <div className="table-card">
        <div className="table-head">
          <div>
            <b>Order Summary</b>
            <small>Customer #{order.customerId}</small>
          </div>

          <span className="badge blue">
            {order.status}
          </span>
        </div>

        <div className="order-items">
          {(order.items || []).map((item, index) => (
            <div
              key={index}
              className="order-card"
              style={{ marginBottom: "10px" }}
            >
              <div className="order-main">
                <strong>Product #{item.productId}</strong>
                <span>
                  Vendor #{item.vendorId}
                  {"  "}
                  Quantity: {item.quantity}
                </span>

                <strong>
                  &#8377;{Number(item.price || 0).toLocaleString("en-IN")}
                </strong>
              </div>
            </div>
          ))}
        </div>

        <div className="summary-total">
          <span>Total Amount</span>
          <strong>
            &#8377;{Number(order.totalAmount || 0).toLocaleString("en-IN")}
          </strong>
        </div>
      </div>

      <div className="table-card" style={{ marginTop: "20px" }}>
        <div className="table-head">
          <div>
            <b>Order Tracking</b>
            <small>Current status: {order.status}</small>
          </div>
        </div>

        <div className="orders-list">
          {steps.map((step, index) => (
            <div className="order-card" key={step}>
              <div className="order-icon">
                <Package size={22}/>
              </div>

              <div className="order-main">
                <strong>{step}</strong>

                <span>
                  {index <= currentStep
                    ? "Completed"
                    : "Pending"}
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}

function Dashboard({ type }) {
  const config = {
    admin: [
      "PLATFORM ADMINISTRATION",
      "Super Admin Dashboard",
      "Monitor the entire MarketGrid ecosystem.",
      "Platform"
    ],
    tenant: [
      "TENANT MANAGEMENT",
      "Store Overview",
      "Manage your marketplace operations from one place.",
      "Tenant"
    ],
    vendor: [
      "VENDOR CENTER",
      "Vendor Dashboard",
      "Manage products, inventory and orders.",
      "Vendor"
    ]
  }[type];

  const [products, setProducts] = useState([]);
  const [vendors, setVendors] = useState([]);
  const [orders, setOrders] = useState([]);
  const [loading, setLoading] = useState(type === "admin");
  const [error, setError] = useState("");

  useEffect(() => {
    if (type !== "admin") return;

    let cancelled = false;

    async function loadDashboard() {
      setLoading(true);
      setError("");

      const token = localStorage.getItem("marketgrid_token");
      const headers = token
        ? { Authorization: `Bearer ${token}` }
        : {};

      try {
        const results = await Promise.all([
          fetch("http://localhost:8080/api/products", { headers }),
          fetch("http://localhost:8080/api/vendors", { headers }),
          fetch("http://localhost:8080/api/orders", { headers })
        ]);

        const failed = results.find(response => !response.ok);

        if (failed) {
          throw new Error(
            `Dashboard API request failed (HTTP ${failed.status}).`
          );
        }

        const [productData, vendorData, orderData] =
          await Promise.all(results.map(response => response.json()));

        if (!Array.isArray(productData) ||
            !Array.isArray(vendorData) ||
            !Array.isArray(orderData)) {
          throw new Error("The dashboard API returned an unexpected response.");
        }

        if (!cancelled) {
          setProducts(productData);
          setVendors(vendorData);
          setOrders(orderData);
        }
      } catch (err) {
        if (!cancelled) {
          setError(err.message || "Unable to load dashboard data.");
        }
      } finally {
        if (!cancelled) setLoading(false);
      }
    }

    loadDashboard();

    return () => {
      cancelled = true;
    };
  }, [type]);

  const totalStock = products.reduce(
    (sum, product) => sum + (Number(product.stockQuantity ?? product.stock) || 0),
    0
  );

  return (
    <div className="content">
      <PageHead
        eyebrow={config[0]}
        title={config[1]}
        description={config[2]}
        action={
          <button
            className="secondary-btn"
            onClick={() => window.location.reload()}
          >
            <RefreshCw size={17} /> Refresh
          </button>
        }
      />

      {error && (
        <div className="info-box" role="alert">
          Could not load all dashboard data: {error}
        </div>
      )}

      <div className="stats">
        <Stat
          icon={Package}
          label="Total Products"
          value={loading ? "Loading..." : products.length}
          note="Products returned by API"
        />
        <Stat
          icon={Users}
          label="Vendors"
          value={loading ? "Loading..." : vendors.length}
          note="Vendors returned by API"
          tone="purple"
        />
        <Stat
          icon={Boxes}
          label="Total Stock"
          value={loading ? "Loading..." : totalStock.toLocaleString("en-IN")}
          note="Units in returned products"
          tone="green"
        />
        <Stat
          icon={Truck}
          label="Orders"
          value={loading ? "Loading..." : orders.length}
          note="Orders returned by API"
          tone="orange"
        />
      </div>

      <div className="dashboard-grid">
        <div className="table-card">
          <div className="table-head">
            <div>
              <b>Platform Products</b>
              <small>
                {loading
                  ? "Loading products..."
                  : `${products.length} products returned by API`}
              </small>
            </div>
            <Link to="/admin/products" className="secondary-btn small">
              View all
            </Link>
          </div>

          <div style={{ overflowX: "auto" }}>
            <table>
              <thead>
                <tr>
                  <th>PRODUCT</th>
                  <th>VENDOR ID</th>
                  <th>PRICE</th>
                  <th>STOCK</th>
                  <th>STATUS</th>
                </tr>
              </thead>
              <tbody>
                {!loading && products.slice(0, 5).map(product => (
                  <tr key={product.id}>
                    <td>
                      <b>{product.name ?? product.productName ?? `Product #${product.id}`}</b>
                    </td>
                    <td>{product.vendorId ?? "Ã¢â‚¬â€"}</td>
                    <td>
                      {formatINR(product.price ?? 0)}
                    </td>
                    <td>{Number(product.stockQuantity ?? product.stock ?? 0)}</td>
                    <td>
                      <span className="badge green">
                        {product.status ?? "Listed"}
                      </span>
                    </td>
                  </tr>
                ))}

                {!loading && !error && products.length === 0 && (
                  <tr>
                    <td colSpan="5">No products were returned by the API.</td>
                  </tr>
                )}

                {loading && (
                  <tr>
                    <td colSpan="5">Loading product records...</td>
                  </tr>
                )}

                {error && !loading && products.length === 0 && (
                  <tr>
                    <td colSpan="5">Product data is unavailable.</td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        </div>

        <div className="panel">
          <div className="panel-title"><b>Quick actions</b></div>
          {type === "admin" && <>
            <Quick icon={Store} text="Manage tenants" href="/admin/tenants" />
            <Quick icon={Users} text="Manage users" href="/admin/users" />
            <Quick icon={BarChart3} text="View analytics" href="/admin/analytics" />
          </>}
          {type === "tenant" && <>
            <Quick icon={Package} text="Add product" href="/tenant/products" />
            <Quick icon={Users} text="Manage vendors" href="/tenant/vendors" />
            <Quick icon={Truck} text="Review orders" href="/tenant/orders" />
          </>}
          {type === "vendor" && <>
            <Quick icon={Plus} text="Add product" href="/vendor/products" />
            <Quick icon={Boxes} text="Update inventory" href="/vendor/inventory" />
            <Quick icon={Truck} text="Process orders" href="/vendor/orders" />
          </>}
        </div>
      </div>
    </div>
  );
}


function Quick({icon:Icon,text,href}) {
  return <Link to={href} className="quick"><Icon size={18}/><span>{text}</span><ChevronRight size={16}/></Link>
}

function GenericPage({ title, description }) {
  return (
    <div className="content narrow">
      <PageHead eyebrow="MARKETGRID MANAGEMENT" title={title} description={description}/>
      <div className="empty-card">
        <BarChart3 size={44}/>
        <h2>{title}</h2>
        <p>This module is connected to the MarketGrid interface and is ready for backend API integration.</p>
        <div className="action-row"><button className="primary-btn"><Plus size={17}/> Create New</button><button className="secondary-btn">Refresh Data</button></div>
      </div>
    </div>
  );
}

function RoleRedirect() {
  const { role } = useAuth();
  if (role === "SUPER_ADMIN") return <Navigate to="/admin" replace/>;
  if (role === "TENANT_ADMIN") return <Navigate to="/tenant" replace/>;
  if (role === "VENDOR") return <Navigate to="/vendor" replace/>;
  if (role === "CUSTOMER") return <Navigate to="/shop" replace/>;
  return <Navigate to="/login" replace/>;
}

function App() {
  return (
    <BrowserRouter>
      <Routes>
        <Route path="/login" element={<Login/>}/><Route path="/register" element={<Register/>}/>
        <Route path="/" element={<><Header/><Home/></>}/>
        <Route element={<Shell/>}>
          <Route path="/shop" element={<CustomerDashboard/>}/>
          <Route path="/shop/products" element={<CustomerShop/>}/>
          <Route path="/cart" element={<Cart/>}/>
          <Route path="/checkout" element={<Checkout/>}/>
          <Route path="/vendors" element={<Vendors/>}/>
          <Route path="/orders" element={<Orders/>}/><Route path="/orders/:id" element={<OrderDetails/>}/>

          <Route path="/admin" element={<Dashboard type="admin"/>}/>
          <Route path="/admin/tenants" element={<TenantsPage/>}/>
          <Route path="/admin/users" element={<AdminUsers/>}/>
          <Route path="/admin/vendors" element={<AdminManagement type="vendors"/>}/>
          <Route path="/admin/products" element={<AdminManagement type="products"/>}/>
          <Route path="/admin/orders" element={<AdminManagement type="orders"/>}/>
          <Route path="/admin/analytics" element={<AdminManagement type="analytics"/>}/>
          <Route path="/admin/settings" element={<AdminManagement type="settings"/>}/>

          <Route path="/tenant" element={<Dashboard type="tenant"/>}/>
          <Route path="/tenant/products" element={<TenantManagement type="products"/>}/>
          <Route path="/tenant/vendors" element={<TenantVendors/>}/>
          <Route path="/tenant/inventory" element={<TenantManagement type="inventory"/>}/>
          <Route path="/tenant/orders" element={<TenantManagement type="orders"/>}/>
          <Route path="/tenant/settings" element={<TenantManagement type="settings"/>}/>

          <Route path="/vendor" element={<VendorDashboard/>}/>
          <Route path="/vendor/products" element={<VendorProducts/>}/>
          <Route path="/vendor/inventory" element={<VendorInventory/>}/>
          <Route path="/vendor/orders" element={<VendorOrders/>}/>
          <Route path="/vendor/settings" element={<GenericPage title="Vendor Settings" description="Manage your vendor profile."/>}/>
        </Route>
        <Route path="*" element={<RoleRedirect/>}/>
      </Routes>
    </BrowserRouter>
  );
}

export default App;


















