function useAuth() {
  const token = localStorage.getItem("marketgrid_token");
  const role = localStorage.getItem("marketgrid_role");
  const tenantId = localStorage.getItem("marketgrid_tenant");
  return { token, role, tenantId };
}

function Header({ onMenu }) {
  const { role } = useAuth();
  const navigate = useNavigate();

  function logout() {
    localStorage.clear();
    navigate("/login");
  }

  return (
    <header className="topbar">
      <button className="mobile-menu" onClick={onMenu}><Menu size={21}/></button>
      <Link to="/" className="brand">
        <span className="brand-mark">M</span>
        <span>
          <strong>MarketGrid</strong>
          <small>Marketplace Platform</small>
        </span>
      </Link>

      <div className="global-search">
        <Search size={18}/>
        <input placeholder="Search products, brands and vendors..." />
      </div>

      <nav className="topnav">
        <Link to="/shop">Products</Link>
        <Link to="/vendors">Vendors</Link>
        <Link to="/orders">Orders</Link>
        <Link to="/cart"><ShoppingCart size={19}/></Link>
        {!role ? (
          <><Link className="secondary-btn small" to="/register">Register</Link><Link className="primary-btn small" to="/login">Sign In</Link></>
        ) : (
          <button className="avatar-btn" onClick={logout}>Logout</button>
        )}
      </nav>
    </header>
  );
}

function Sidebar({ role, open, onClose }) {
  const admin = role === "SUPER_ADMIN";
  const tenant = role === "TENANT_ADMIN";
  const vendor = role === "VENDOR";
  const customer = role === "CUSTOMER";

  const links = customer
    ? [
        ["/shop", LayoutDashboard, "Marketplace"],
        ["/shop/products", Package, "Products"],
        ["/vendors", Store, "Vendors"],
        ["/cart", ShoppingCart, "My Cart"],
        ["/orders", Truck, "My Orders"]
      ]
    : vendor
    ? [
        ["/vendor", LayoutDashboard, "Overview"],
        ["/vendor/products", Package, "My Products"],
        ["/vendor/inventory", Boxes, "Inventory"],
        ["/vendor/orders", Truck, "Orders"],
        ["/vendor/settings", Settings, "Settings"]
      ]
    : tenant
    ? [
        ["/tenant", LayoutDashboard, "Overview"],
        ["/tenant/products", Package, "Products"],
        ["/tenant/vendors", Users, "Vendors"],
        ["/tenant/inventory", Boxes, "Inventory"],
        ["/tenant/orders", Truck, "Orders"],
        ["/tenant/settings", Settings, "Settings"]
      ]
    : admin
    ? [
        ["/admin", LayoutDashboard, "Platform Overview"],
        ["/admin/tenants", Store, "Tenants"],
        ["/admin/users", Users, "Users"],
        ["/admin/vendors", Users, "Vendors"],
        ["/admin/products", Package, "Products"],
        ["/admin/orders", Truck, "Orders"],
        ["/admin/analytics", BarChart3, "Analytics"],
        ["/admin/settings", Settings, "Settings"]
      ]
    : [];

  if (!role) return null;

  return (
    <aside className={`sidebar ${open ? "open" : ""}`}>
      <div className="sidebar-head">
        <div className="mini-brand"><span className="brand-mark">M</span><b>MarketGrid</b></div>
        <button className="close-menu" onClick={onClose}><X size={19}/></button>
      </div>

      <div className="role-box">
        <ShieldCheck size={18}/>
        <div>
          <b>{role.replace("_", " ")}</b>
          <small>{role === "SUPER_ADMIN" ? "Platform Administration" : `Tenant #${localStorage.getItem("marketgrid_tenant") || 1}`}</small>
        </div>
      </div>

      <p className="side-label">MAIN</p>
      {links.map(([path, Icon, label]) => (
        <Link key={path} to={path} onClick={onClose} className="side-link">
          <Icon size={18}/><span>{label}</span>
        </Link>
      ))}

      <div className="sidebar-bottom">
        <button className="side-link" onClick={() => { localStorage.clear(); location.href="/login"; }}>
          <LogOut size={18}/> <span>Sign out</span>
        </button>
      </div>
    </aside>
  );
}

function Shell({ children }) {
  const { role } = useAuth();
  const [open, setOpen] = useState(false);
  return (
    <div className="app">
      <Header onMenu={() => setOpen(true)}/>
      <Sidebar role={role} open={open} onClose={() => setOpen(false)}/>
      <main className={role ? "main with-sidebar" : "main"}><Outlet /></main>
    </div>
  );
}

function Stat({ icon: Icon, label, value, note, tone="blue" }) {
  return (
    <div className="stat">
      <div className={`stat-icon ${tone}`}><Icon size={20}/></div>
      <div><span>{label}</span><strong>{value}</strong><small>{note}</small></div>
    </div>
  );
}

function PageHead({ eyebrow, title, description, action }) {
  return (
    <div className="page-head">
      <div>
        {eyebrow && <p className="eyebrow">{eyebrow}</p>}
        <h1>{title}</h1>
        <p>{description}</p>
      </div>
      {action}
